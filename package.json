{
  "name": "p2pshare-desktop",
  "private": true,
  "version": "1.1.1",
  "description": "Direct encrypted QUIC file transfer for Windows and Android",
  "author": "AagneyVk",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:engine": "cargo build --locked --release --manifest-path transport-core/Cargo.toml --bin p2pshare-engine",
    "prepare:desktop": "npm run build && npm run build:engine",
    "desktop:quic": "npm run desktop",
    "desktop:legacy": "npm run build && npm run build:native && electron electron/main.cjs --legacy",
    "test:engine": "node --test tests/quic-bridge.test.cjs",
    "test": "node --test tests/transport-security.test.cjs tests/ipc-policy.test.cjs tests/app-updater.test.cjs",
    "dev": "vite",
    "desktop": "npm run prepare:desktop && electron electron/main.cjs",
    "build": "tsc && vite build",
    "build:native": "cargo build --release --manifest-path native-core/Cargo.toml && node native-core/install-addon.cjs",
    "benchmark:native": "node native-core/benchmark.cjs",
    "preview": "vite preview",
    "dist:win": "npm run prepare:desktop && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.p2pshare.desktop",
    "productName": "P2PShare",
    "artifactName": "P2PShare-Setup.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "transport-core/target/release/p2pshare-engine.exe",
        "to": "p2pshare-engine.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
