{
  "name": "p2pshare-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "electron electron/main.cjs",
    "build": "tsc && vite build",
    "build:native": "cargo build --release --manifest-path native-core/Cargo.toml && node native-core/install-addon.cjs",
    "benchmark:native": "node native-core/benchmark.cjs",
    "benchmark:compression": "node native-core/compression-benchmark.cjs",
    "benchmark:research": "npm run benchmark:native -- --json && npm run benchmark:compression -- --json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "electron": "^31.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.15",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
